{
  "expo": {
    "name": "pokedex",
    "slug": "mobile-pokedex",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "pokedex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.ico"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo_1.png",
        "backgroundImage": "./assets/images/logo_2.png",
        "monochromeImage": "./assets/images/logo_3.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.akimdev77.mobilepokedex"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D8D8D8",
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75deea2a-d5ad-4aca-9c83-285cf952c736"
      }
    },
    "owner": "akimdev77"
  }
}
